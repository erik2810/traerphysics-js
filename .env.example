# Copy to .env and adjust. Loaded manually by your shell / process manager —
# the app does not currently auto-load .env files.

# Physics loop rate in Hz (read by backend/config.py).
TRAERPHYSICS_TICK_RATE=60

# Logging level. NOTE: read by config.py but not yet wired into logging setup.
TRAERPHYSICS_LOG_LEVEL=INFO

# API key for mutating endpoints. Leave blank to disable auth entirely.
# When set, only POST /api/reset enforces it at the moment.
TRAERPHYSICS_API_KEY=

# Maximum particle count. Currently informational only — not enforced.
TRAERPHYSICS_MAX_PARTICLES=4096
